{
  "manifest_version": 3,
  "name": "RSS Blocks",
  "version": "1.0.0",
  "description": "複数のRSS/Atomフィードをブロック形式で一覧表示します",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "RSS Blocks を開く"
  }
}
